# ───────────────────────────────────────────────
# MCP Outreach Engine — Environment Configuration
# ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Demo mode works without any of these — just cp .env.example .env and run.

# ─── LLM Provider ───
# Required for live reply classification and tuning (demo mode works without this)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ─── MCP Transport ───
# Set to 'stdio' for CLI integration, 'sse' for HTTP streaming
# Default: sse
MCP_TRANSPORT=sse

# ─── Sequencer APIs ───
# Required for live sequence sending (demo mode works without these)
OUTREACH_API_KEY=
SALESLOFT_API_KEY=

# ─── LinkedIn Automation ───
# Required for LinkedIn sequences (demo mode works without these)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
UNIPILE_API_KEY=

# ─── CRM ───
# Required for lead status sync (demo mode works without these)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_API_KEY=
